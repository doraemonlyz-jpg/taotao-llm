# ─── Hugging Face ─────────────────────────────────────────────────────────
# 拿 token: https://huggingface.co/settings/tokens (read 权限就够 phase 1-7)
HF_TOKEN=hf_replace_me

# 把 HF 缓存重定向到 repo 内的 data/ · 不污染 ~/.cache
HF_HOME=./data/hf_cache
HF_DATASETS_CACHE=./data/hf_cache/datasets

# ─── Weights & Biases (optional · phase 3+ 强烈推荐) ────────────────────
# 不想用就 set WANDB_DISABLED=true
WANDB_API_KEY=
WANDB_PROJECT=taotao-llm
WANDB_DISABLED=true

# ─── PyTorch device ───────────────────────────────────────────────────────
# auto = 检测顺序 cuda → mps → cpu
TORCH_DEVICE=auto

# ─── 实验默认参数 (可在脚本里 override) ──────────────────────────────────
DEFAULT_SEED=42
DEFAULT_BATCH_SIZE=8

# ─── Phase 9 部署 (Ollama) ────────────────────────────────────────────────
# 训出的 GGUF 自动注册到 Ollama 后给 taotao-agent 用
OLLAMA_MODEL_DIR=~/.ollama/models
EXPORT_TO_OLLAMA=false
