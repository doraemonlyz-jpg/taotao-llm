*.swo
*~

# ── Secrets / env ───────────────────────────────────────────────────────
.env
.env.local
.env.*.local
!.env.example
*.pem
*.key

# ── ML data / models / runs · NEVER COMMIT ──────────────────────────────
# We DO commit the data/ folder marker + its README, but ignore everything
# else inside it. The trailing /* + ! pattern is the only form git respects
# (negation can't undo an ignored directory).
data/*
!data/.gitkeep
!data/README.md
runs/
wandb/
mlruns/
lightning_logs/
*.pt
*.bin
*.safetensors
*.gguf
*.ckpt
*.onnx

# ── HF cache redirects (set HF_HOME=./data/hf_cache in .env) ────────────
.cache/

# ── Notebook checkpoints ────────────────────────────────────────────────
.ipynb_checkpoints/
*-checkpoint.ipynb

# ── uv / lockfiles you may want ─────────────────────────────────────────
# uv.lock — KEEP this committed for reproducible installs
# (don't ignore)
